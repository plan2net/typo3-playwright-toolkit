#!/bin/bash
#ddev-generated

## Description: Run Playwright against fresh per-test databases
## Usage: playwright [subcommand] [options]
## Example: "ddev playwright test" or "ddev playwright test accordion --skip-build"
## ExecRaw: true

if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    echo "Usage: ddev playwright [subcommand] [options]"
    echo ""
    echo "Everything is forwarded to 'npx playwright', so any subcommand and flag"
    echo "works. Before 'test' your frontend assets are built and the test database"
    echo "template is checked and rebuilt when your schema, fixtures or session seed"
    echo "changed, so a TCA or ext_tables.sql change never runs against a stale"
    echo "schema and the tests never shoot yesterday's CSS."
    echo ""
    echo "Subcommands this command handles itself:"
    echo "  approve [filter]    Approve and update snapshots for failed tests or a filter"
    echo "  clean               Drop what a stopped run left behind"
    echo "  doctor              Start a browser and a test database to prove a run works"
    echo "  inspect [filter]    Print backend links for kept test databases"
    echo "  prepare [--force]   Build the test database template"
    echo "  replay [filter]     Build scenarios in the replay database"
    echo "  setup               Set up this project for Playwright, or check a setup you have"
    echo "  show-report         Playwright's own, served where your browser can reach it"
    echo "  trace [file]        View a saved trace in your browser"
    echo "  ui [filter]         Open Playwright's UI mode"
    echo ""
    echo "Options this command handles itself:"
    echo "  --skip-build        Do not build frontend assets first"
    echo "  --no-cleanup        Keep test databases and state after the run"
    echo "  --skip-prepare      Reuse the existing test database template"
    echo ""
    echo "The asset build is the toolkit's: it runs your package.json 'build' script"
    echo "through the package manager your lockfile names. Set 'build' in"
    echo "defineToolkitConfig to run something else, or false to never build."
    echo ""
    echo "Env (set these in web_environment or .ddev/.env.web to reach this command):"
    echo "  PW_TEST_DIR         Where your Playwright tests live, default tests/playwright"
    echo "  PW_RUN_ID           Pins the run namespace used for cleanup bookkeeping"
    echo "  PW_REPORT_PORT      Port 'show-report' serves on, default 9323"
    echo ""
    echo "Examples:"
    echo "  ddev playwright test                                  # everything"
    echo "  ddev playwright test accordion                        # one file, by path"
    echo "  ddev playwright test --grep 'three facts'              # by test title"
    echo "  ddev playwright approve                               # update snapshots for failed tests"
    echo "  ddev playwright approve accordion                     # update snapshots for one file"
    echo "  ddev playwright approve --all                         # update snapshots for all tests"
    echo "  ddev playwright test --project=chromium-desktop        # one browser"
    echo "  ddev playwright test -c playwright.local.config.ts     # another config"
    echo "  ddev playwright show-report"
    echo "  ddev playwright install chromium                      # any Playwright command"
    exit 0
fi

if [ "$1" = "ui" ]; then
    shift
    exec bash "${PW_ADDON_CONFIG_DIR:-/mnt/ddev_config}/commands/web/playwright-ui" "$@"
fi

if [ "$1" = "inspect" ] || [ "$1" = "replay" ] || [ "$1" = "prepare" ] || [ "$1" = "doctor" ] \
    || [ "$1" = "clean" ]; then
    subcommand="$1"
    shift
    exec bash "${PW_ADDON_CONFIG_DIR:-/mnt/ddev_config}/playwright-commands/${subcommand}.sh" "$@"
fi

# Setup must work before the test directory exists.
if [ "$1" = "setup" ]; then
    cd "${DDEV_APPROOT:-/var/www/html}" || exit 1

    if ! vendor/bin/typo3 list 2>/dev/null | grep -q 'playwright:setup'; then
        echo "[playwright] The extension is not installed. Run:"
        echo "  ddev composer require --dev plan2net/playwright-toolkit"
        exit 1
    fi

    shift
    # A project may apply the toolkit settings for the Testing context only, and the
    # checks then read empty values in any other one.
    exec env TYPO3_CONTEXT=Testing vendor/bin/typo3 playwright:setup "$@"
fi

if [ "$1" = "approve" ]; then
    for arg in "${@:2}"; do
        if [ "${arg}" = "--help" ] || [ "${arg}" = "-h" ]; then
            echo "Usage: ddev playwright approve [filter] [options]"
            echo ""
            echo "Without a filter, updates snapshots only for the last failed tests."
            echo "It never falls back to the whole suite when no failures were recorded."
            echo "  --all           Update snapshots across the whole suite"
            echo "  --grep PATTERN  Select tests by title"
            echo "  --skip-build    Skip the frontend asset build"
            echo "  --skip-prepare  Reuse the existing database template"
            echo ""
            echo "File filters and Playwright test options are supported."
            exit 0
        fi
    done
fi

if [ "$1" = "trace" ] && { [ "${2:-}" = "--help" ] || [ "${2:-}" = "-h" ]; }; then
    echo "Usage: ddev playwright trace [file.zip] [--output directory]"
    echo ""
    echo "Serves Playwright's Trace Viewer and prints its browser URL."
    echo "Without a file, selects the newest trace.zip in test-results."
    echo "--output selects a different results directory under PW_TEST_DIR."
    echo "Stop the viewer with Ctrl-C."
    exit 0
fi

. "${PW_ADDON_CONFIG_DIR:-/mnt/ddev_config}/playwright-lib.sh" || exit 1

command_directory="${PWD}"
playwright_enter_test_dir || exit 1

playwright_collect_args "$@"

if [ "${PW_ARGS[0]:-}" = "trace" ]; then
    set -- "${PW_ARGS[@]:1}"
    trace_file=""
    trace_output="test-results"
    while [ $# -gt 0 ]; do
        case "$1" in
            --output)
                if [ $# -lt 2 ] || [ -z "$2" ] || [[ "$2" == -* ]]; then
                    echo "[playwright] --output needs a directory." >&2
                    exit 1
                fi
                shift
                trace_output="$1"
                ;;
            --output=*)
                trace_output="${1#*=}"
                ;;
            -*)
                echo "[playwright] Unknown trace option: $1. See 'ddev playwright trace --help'." >&2
                exit 1
                ;;
            *)
                if [ -n "${trace_file}" ]; then
                    echo "[playwright] Choose one trace file." >&2
                    exit 1
                fi
                trace_file="$1"
                ;;
        esac
        shift
    done
    if [[ "${trace_file}" != /* ]] && [ -f "${command_directory}/${trace_file}" ]; then
        trace_file="${command_directory}/${trace_file}"
    fi
    if [ -z "${trace_file}" ] && [ -d "${trace_output}" ]; then
        while IFS= read -r -d '' candidate; do
            if [ -z "${trace_file}" ] || [ "${candidate}" -nt "${trace_file}" ]; then
                trace_file="${candidate}"
            fi
        done < <(find "${trace_output}" -type f -name trace.zip -print0)
    fi
    if [ -z "${trace_file}" ]; then
        echo "[playwright] No trace.zip found in ${trace_output}. Record a trace with:" >&2
        echo "[playwright]   ddev playwright test --trace retain-on-failure" >&2
        exit 1
    fi
    if [ ! -f "${trace_file}" ] || [ ! -r "${trace_file}" ]; then
        echo "[playwright] Cannot read trace: ${trace_file}" >&2
        exit 1
    fi
    echo "[playwright] Trace: ${trace_file}"
    trace_url="$(playwright_serve_url 9325)"
    if [[ "${trace_url}" == http://* ]]; then
        trace_url="$(playwright_serve_url 9326)"
    fi
    echo "[playwright] Open ${trace_url}"
    echo "[playwright] Stop with Ctrl-C."
    # Redirected before the exec, not piped after it: a shell left waiting in front
    # of the viewer swallows the SIGTERM meant for it.
    exec > >(playwright_reachable_url 9325 "${trace_url}") 2>&1
    exec npx playwright show-trace --host 0.0.0.0 --port 9325 -- "${trace_file}"
fi

# show-report binds to 127.0.0.1, which is unreachable from outside the container.
if [ "${PW_ARGS[0]:-}" = "show-report" ]; then
    PORT="${PW_REPORT_PORT:-9323}"
    report_url="$(playwright_serve_url "${PORT}")"

    echo ""
    echo "[playwright] Open ${report_url}"
    echo "[playwright] Stop with Ctrl-C."
    echo ""

    exec > >(playwright_reachable_url "${PORT}" "${report_url}") 2>&1
    exec npx playwright show-report --host 0.0.0.0 --port "${PORT}" "${PW_ARGS[@]:1}"
fi

# Other subcommands must not boot TYPO3.
if [ "${PW_ARGS[0]:-}" != "test" ] && [ "${PW_ARGS[0]:-}" != "approve" ]; then
    exec npx playwright "${PW_ARGS[@]}"
fi

if [ "${PW_ARGS[0]:-}" = "approve" ]; then
    playwright_resolve_approve_args "${PW_ARGS[@]:1}" || exit 1
fi

playwright_prepare_template "${DDEV_APPROOT:-/var/www/html}" || exit 1

# Not exec'd, because our closing hint has to come after Playwright's own, which
# names `npx playwright show-report` and binds to container loopback. Outliving the
# run costs signal forwarding by hand, and a stdin an async command would lose.
if [ "${PW_ARGS[0]:-}" = "approve" ]; then
    node "${PW_ADDON_CONFIG_DIR:-/mnt/ddev_config}/playwright-approve.mjs" "${PW_APPROVE_ARGS[@]}" <&0 &
else
    npx playwright "${PW_ARGS[@]}" <&0 &
fi
run=$!
trap 'kill -TERM "${run}" 2>/dev/null' INT TERM
wait "${run}"
status=$?

if [ -d playwright-report ]; then
    echo ""
    echo "[playwright] Open the report with:"
    echo ""
    echo "  ddev playwright show-report"
    echo ""
fi

exit "${status}"
