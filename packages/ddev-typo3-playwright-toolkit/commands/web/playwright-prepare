if [ ! -x "/var/www/html/vendor/bin/typo3" ]; then
    echo "[playwright] vendor/bin/typo3 not found. Run 'ddev composer install' first." >&2
    exit 1
fi

. /mnt/ddev_config/playwright-lib.sh

