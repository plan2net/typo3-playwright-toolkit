parameters:
    level: 8
    # The floor the package ships against, not the one it is developed on: the
    # dev toolchain needs 8.3 (phpunit 12), consumers only need 8.1. This is what
    # fails the build when an 8.2/8.3-only feature creeps back in.
    phpVersion: 80100
    paths:
        - Classes
        - Tests
    excludePaths:
        # Extensions TYPO3 loads, not code this package calls: ext_emconf.php is
        # handed its $_EXTKEY by the extension manager.
        - Tests/Functional/Fixtures/Extensions/*
    ignoreErrors:
        # Only true for the core installed here: rebuild() arrived with the 13.4
        # schema API, so the guard is load-bearing on 11.5 and 12.4.
        -
            message: '#^Call to function method_exists\(\) with TYPO3\\CMS\\Core\\Schema\\TcaSchemaFactory and .rebuild. will always evaluate to true\.$#'
            identifier: function.alreadyNarrowedType
            path: '*/Tests/Functional/DataHandling/ContentDatamapTest.php'
        # Every connection this package opens sets PDO::ERRMODE_EXCEPTION, so
        # query() and prepare() throw rather than returning false. Narrowing 20
        # call sites for a branch that cannot be reached would only add noise.
        -
            message: '#Cannot call method \w+\(\) on PDOStatement\|false\.#'
            identifier: method.nonObject
