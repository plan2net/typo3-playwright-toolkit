{
    "name": "plan2net/playwright-toolkit-e2e-consumer",
    "description": "Fixture TYPO3 project the consumer end-to-end job installs all three packages into.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "typo3/cms-backend": "^12.4 || ^13.4 || ^14.3",
        "typo3/cms-core": "^12.4 || ^13.4 || ^14.3",
        "typo3/cms-fluid-styled-content": "^12.4 || ^13.4 || ^14.3",
        "typo3/cms-frontend": "^12.4 || ^13.4 || ^14.3",
        "typo3/cms-install": "^12.4 || ^13.4 || ^14.3"
    },
    "require-dev": {
        "plan2net/boot-probe": "@dev",
        "plan2net/playwright-toolkit": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "./.artifacts/playwright-toolkit",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "./packages/boot-probe",
            "options": {
                "symlink": false
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "extra": {
        "typo3/cms": {
            "web-dir": "public"
        }
    }
}
