# Static analysis for the TYPO3 12 row of typo3-versions only. Delete with 12.4
# support; nothing else references it.
#
# AtomicOutputGifBuilder overrides output() as 13.4 and 14.3 declare it, so it
# cannot be analysed against this core.
parameters:
    excludePaths:
        - '*/Compatibility/AtomicOutputGifBuilder.php'
    # SiteWithSettings guards getTSconfig(), which arrived in 13.0, and the
    # overlay test reads noCache, which phpstan-typo3 checks but is not
    # installed here. Both carry inline ignores that match nothing on this core.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Called only when Site has getTSconfig(), which arrived with getTypoScript().
        -
            message: '#^Call to an undefined method TYPO3\\CMS\\Core\\Site\\Entity\\Site::getTypoScript\(\)\.$#'
            identifier: method.notFound
            path: '*/Compatibility/SiteWithSettings.php'
        -
            message: '#^Class TYPO3\\CMS\\Core\\Site\\Entity\\Site constructor invoked with 6 parameters#'
            identifier: arguments.count
            path: '*/Compatibility/SiteWithSettings.php'
